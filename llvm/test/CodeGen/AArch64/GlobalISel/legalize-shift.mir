name: test_lshr_nonpow2
body:             |
  bb.0:
    ; CHECK-LABEL: name: test_lshr_nonpow2
    ; CHECK: [[COPY:%[0-9]+]]:_(s64) = COPY $x0
    ; CHECK-NEXT: %a:_(s32) = COPY $w1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 32
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(s32), [[C2]](i32)
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL [[MV]], [[C]](i64)
    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(i64) = G_SHL [[C1]], [[C]](i64)
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR [[MV]], [[C]](i64)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i64) = G_OR [[SHL1]], [[LSHR]]
    ; CHECK-NEXT: [[MV1:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(s32), [[C2]](i32)
    ; CHECK-NEXT: [[OR1:%[0-9]+]]:_(i64) = G_OR [[MV1]], [[SHL]]
    ; CHECK-NEXT: [[OR2:%[0-9]+]]:_(i64) = G_OR [[C1]], [[OR]]
    ; CHECK-NEXT: [[MV2:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(s32), [[C2]](i32)
    ; CHECK-NEXT: [[OR3:%[0-9]+]]:_(s64) = G_OR [[OR1]], [[C1]]
    ; CHECK-NEXT: [[OR4:%[0-9]+]]:_(s64) = G_OR [[OR2]], [[MV2]]
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[OR3]](s64)
    ; CHECK-NEXT: [[UV2:%[0-9]+]]:_(i32), [[UV3:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[OR4]](s64)
    ; CHECK-NEXT: [[MV3:%[0-9]+]]:_(s64) = G_MERGE_VALUES [[UV]](i32), [[UV1]](i32)
    ; CHECK-NEXT: [[MV4:%[0-9]+]]:_(s64) = G_MERGE_VALUES [[UV2]](i32), [[C2]](i32)
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(s64) = G_CONSTANT i64 64
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(s64) = G_SUB [[COPY]], [[C3]]
    ; CHECK-NEXT: [[SUB1:%[0-9]+]]:_(s64) = G_SUB [[C3]], [[COPY]]
    ; CHECK-NEXT: [[C4:%[0-9]+]]:_(s64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[COPY]](s64), [[C3]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[COPY]](s64), [[C4]]
    ; CHECK-NEXT: [[LSHR1:%[0-9]+]]:_(s64) = G_LSHR [[MV3]], [[COPY]](s64)
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(s64) = G_SHL [[MV4]], [[SUB1]](s64)
    ; CHECK-NEXT: [[OR5:%[0-9]+]]:_(s64) = G_OR [[LSHR1]], [[SHL2]]
    ; CHECK-NEXT: [[LSHR2:%[0-9]+]]:_(s64) = G_LSHR [[MV4]], [[SUB]](s64)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(s64) = G_SELECT [[ICMP]](i32), [[OR5]], [[LSHR2]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(s64) = G_SELECT [[ICMP1]](i32), [[MV3]], [[SELECT]]
    ; CHECK-NEXT: %d1:_(s32), %d2:_(s32) = G_UNMERGE_VALUES [[SELECT1]](s64)
    ; CHECK-NEXT: $w0 = COPY %d2(s32)
    %0:_(s64) = COPY $x0
    %a:_(s32) = COPY $w1
    %merge:_(s96) = G_MERGE_VALUES %a, %a, %a
    %lshr:_(s96) = G_LSHR %merge, %0
    %d1:_(s32), %d2:_(s32), %d3:_(s32) = G_UNMERGE_VALUES %lshr
    $w0 = COPY %d2(s32)

...
---
name: test_lshr_nonpow2_wide
body:             |
  bb.0:
    ; CHECK-LABEL: name: test_lshr_nonpow2_wide
    ; CHECK: [[COPY:%[0-9]+]]:_(s64) = COPY $x0
    ; CHECK-NEXT: %a:_(s32) = COPY $w1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 32
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(s32), [[C2]](i32)
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL [[MV]], [[C]](i64)
    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(i64) = G_SHL [[C1]], [[C]](i64)
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR [[MV]], [[C]](i64)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i64) = G_OR [[SHL1]], [[LSHR]]
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(i64) = G_SHL [[C1]], [[C]](i64)
    ; CHECK-NEXT: [[LSHR1:%[0-9]+]]:_(i64) = G_LSHR [[C1]], [[C]](i64)
    ; CHECK-NEXT: [[OR1:%[0-9]+]]:_(i64) = G_OR [[SHL2]], [[LSHR1]]
    ; CHECK-NEXT: [[MV1:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(s32), [[C2]](i32)
    ; CHECK-NEXT: [[OR2:%[0-9]+]]:_(i64) = G_OR [[MV1]], [[SHL]]
    ; CHECK-NEXT: [[OR3:%[0-9]+]]:_(i64) = G_OR [[C1]], [[OR]]
    ; CHECK-NEXT: [[OR4:%[0-9]+]]:_(i64) = G_OR [[C1]], [[OR1]]
    ; CHECK-NEXT: [[MV2:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(s32), [[C2]](i32)
    ; CHECK-NEXT: [[OR5:%[0-9]+]]:_(i64) = G_OR [[C1]], [[C1]]
    ; CHECK-NEXT: [[OR6:%[0-9]+]]:_(i64) = G_OR [[OR2]], [[C1]]
    ; CHECK-NEXT: [[OR7:%[0-9]+]]:_(i64) = G_OR [[OR3]], [[MV2]]
    ; CHECK-NEXT: [[OR8:%[0-9]+]]:_(i64) = G_OR [[OR4]], [[OR5]]
    ; CHECK-NEXT: [[MV3:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(s32), [[C2]](i32)
    ; CHECK-NEXT: [[SHL3:%[0-9]+]]:_(i64) = G_SHL [[MV3]], [[C]](i64)
    ; CHECK-NEXT: [[LSHR2:%[0-9]+]]:_(i64) = G_LSHR [[MV3]], [[C]](i64)
    ; CHECK-NEXT: [[SHL4:%[0-9]+]]:_(i64) = G_SHL [[C1]], [[C]](i64)
    ; CHECK-NEXT: [[OR9:%[0-9]+]]:_(i64) = G_OR [[LSHR2]], [[SHL4]]
    ; CHECK-NEXT: [[OR10:%[0-9]+]]:_(i64) = G_OR [[C1]], [[OR9]]
    ; CHECK-NEXT: [[OR11:%[0-9]+]]:_(i64) = G_OR [[OR6]], [[C1]]
    ; CHECK-NEXT: [[OR12:%[0-9]+]]:_(i64) = G_OR [[OR7]], [[SHL3]]
    ; CHECK-NEXT: [[OR13:%[0-9]+]]:_(i64) = G_OR [[OR8]], [[OR10]]
    ; CHECK-NEXT: [[MV4:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(s32), [[C2]](i32)
    ; CHECK-NEXT: [[OR14:%[0-9]+]]:_(s64) = G_OR [[OR11]], [[C1]]
    ; CHECK-NEXT: [[OR15:%[0-9]+]]:_(s64) = G_OR [[OR12]], [[C1]]
    ; CHECK-NEXT: [[OR16:%[0-9]+]]:_(s64) = G_OR [[OR13]], [[MV4]]
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[OR14]](s64)
    ; CHECK-NEXT: [[UV2:%[0-9]+]]:_(i32), [[UV3:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[OR15]](s64)
    ; CHECK-NEXT: [[UV4:%[0-9]+]]:_(i32), [[UV5:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[OR16]](s64)
    ; CHECK-NEXT: [[MV5:%[0-9]+]]:_(s64) = G_MERGE_VALUES [[UV]](i32), [[UV1]](i32)
    ; CHECK-NEXT: [[MV6:%[0-9]+]]:_(s64) = G_MERGE_VALUES [[UV2]](i32), [[UV3]](i32)
    ; CHECK-NEXT: [[MV7:%[0-9]+]]:_(s64) = G_MERGE_VALUES [[UV4]](i32), [[C2]](i32)
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(s64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[C4:%[0-9]+]]:_(s64) = G_CONSTANT i64 128
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(s64) = G_SUB [[COPY]], [[C4]]
    ; CHECK-NEXT: [[SUB1:%[0-9]+]]:_(s64) = G_SUB [[C4]], [[COPY]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[COPY]](s64), [[C4]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[COPY]](s64), [[C3]]
    ; CHECK-NEXT: [[C5:%[0-9]+]]:_(s64) = G_CONSTANT i64 64
    ; CHECK-NEXT: [[SUB2:%[0-9]+]]:_(s64) = G_SUB [[COPY]], [[C5]]
    ; CHECK-NEXT: [[SUB3:%[0-9]+]]:_(s64) = G_SUB [[C5]], [[COPY]]
    ; CHECK-NEXT: [[ICMP2:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[COPY]](s64), [[C5]]
    ; CHECK-NEXT: [[ICMP3:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[COPY]](s64), [[C3]]
    ; CHECK-NEXT: [[LSHR3:%[0-9]+]]:_(s64) = G_LSHR [[MV5]], [[COPY]](s64)
    ; CHECK-NEXT: [[SHL5:%[0-9]+]]:_(s64) = G_SHL [[MV6]], [[SUB3]](s64)
    ; CHECK-NEXT: [[OR17:%[0-9]+]]:_(s64) = G_OR [[LSHR3]], [[SHL5]]
    ; CHECK-NEXT: [[LSHR4:%[0-9]+]]:_(s64) = G_LSHR [[MV6]], [[SUB2]](s64)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(s64) = G_SELECT [[ICMP2]](i32), [[OR17]], [[LSHR4]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(s64) = G_SELECT [[ICMP3]](i32), [[MV5]], [[SELECT]]
    ; CHECK-NEXT: [[ICMP4:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[SUB1]](s64), [[C5]]
    ; CHECK-NEXT: [[SHL6:%[0-9]+]]:_(s64) = G_SHL [[MV7]], [[SUB1]](s64)
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(s64) = G_SELECT [[ICMP4]](i32), [[SHL6]], [[C3]]
    ; CHECK-NEXT: [[OR18:%[0-9]+]]:_(s64) = G_OR [[SELECT1]], [[SELECT2]]
    ; CHECK-NEXT: [[SUB4:%[0-9]+]]:_(s64) = G_SUB [[SUB]], [[C5]]
    ; CHECK-NEXT: [[SUB5:%[0-9]+]]:_(s64) = G_SUB [[C5]], [[SUB]]
    ; CHECK-NEXT: [[ICMP5:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[SUB]](s64), [[C5]]
    ; CHECK-NEXT: [[ICMP6:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[SUB]](s64), [[C3]]
    ; CHECK-NEXT: [[LSHR5:%[0-9]+]]:_(s64) = G_LSHR [[MV7]], [[SUB]](s64)
    ; CHECK-NEXT: [[SHL7:%[0-9]+]]:_(s64) = G_SHL [[C3]], [[SUB5]](s64)
    ; CHECK-NEXT: [[OR19:%[0-9]+]]:_(s64) = G_OR [[LSHR5]], [[SHL7]]
    ; CHECK-NEXT: [[LSHR6:%[0-9]+]]:_(s64) = G_LSHR [[C3]], [[SUB4]](s64)
    ; CHECK-NEXT: [[SELECT3:%[0-9]+]]:_(s64) = G_SELECT [[ICMP5]](i32), [[OR19]], [[LSHR6]]
    ; CHECK-NEXT: [[SELECT4:%[0-9]+]]:_(s64) = G_SELECT [[ICMP6]](i32), [[MV7]], [[SELECT3]]
    ; CHECK-NEXT: [[SELECT5:%[0-9]+]]:_(s64) = G_SELECT [[ICMP]](i32), [[OR18]], [[SELECT4]]
    ; CHECK-NEXT: [[SELECT6:%[0-9]+]]:_(s64) = G_SELECT [[ICMP1]](i32), [[MV5]], [[SELECT5]]
    ; CHECK-NEXT: %d1:_(s32), %d2:_(s32) = G_UNMERGE_VALUES [[SELECT6]](s64)
    ; CHECK-NEXT: $w0 = COPY %d2(s32)
    %0:_(s64) = COPY $x0
    %a:_(s32) = COPY $w1
    %merge:_(s160) = G_MERGE_VALUES %a, %a, %a, %a, %a
    %lshr:_(s160) = G_LSHR %merge, %0
    %d1:_(s32), %d2:_(s32), %d3:_(s32), %d4:_(s32), %d5:_(s32) = G_UNMERGE_VALUES %lshr
    $w0 = COPY %d2(s32)

...
---
name: test_lshr_i48
body:             |
  bb.1.entry:
    liveins: $x0

    ; CHECK-LABEL: name: test_lshr_i48
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i32) = G_LSHR [[TRUNC]], [[C]](i64)
    ; CHECK-NEXT: $w0 = COPY [[LSHR]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %1:_(i64) = COPY $x0
    %0:_(i48) = G_TRUNC %1(i64)
    %6:_(i32) = G_TRUNC %0(i48)
    %2:_(i48) = G_CONSTANT i48 1
    %7:_(i32) = G_LSHR %6, %2(i48)
    $w0 = COPY %7(i32)
    RET_ReallyLR implicit $w0

...
